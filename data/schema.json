{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mizan.local/schema/legislation.schema.json",
  "title": "Mizan Legislation Instrument",
  "type": "object",
  "required": [
    "id",
    "title_en",
    "jurisdiction",
    "regulator",
    "topic_tags",
    "applies_to",
    "status",
    "effective_date",
    "last_verified",
    "source_url",
    "plain_summary_en",
    "related_ids"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title_en": {"type": "string"},
    "title_ar": {"type": ["string", "null"]},
    "jurisdiction": {"type": "string", "enum": ["Federal", "Dubai", "DIFC", "ADGM"]},
    "regulator": {"type": "string"},
    "topic_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "applies_to": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"type": "string", "enum": ["current", "superseded", "repealed", "draft", "unknown"]},
    "superseded_by": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "source_url": {"type": "string", "format": "uri"},
    "plain_summary_en": {"type": "string"},
    "plain_summary_ar": {"type": ["string", "null"]},
    "full_text_en": {"type": ["string", "null"]},
    "full_text_ar": {"type": ["string", "null"]},
    "related_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "number": {"type": ["string", "null"]},
    "authority": {"type": ["string", "null"]},
    "relevance_en": {"type": ["string", "null"]},
    "note_en": {"type": ["string", "null"]},
    "search_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
